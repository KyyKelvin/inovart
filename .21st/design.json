  "decisions": [
    {
      "name": "Work detail layout",
      "decision": "Use a compact editorial two-column composition with one primary XP-framed image, narrative and object metadata beside it, and deduplicated complementary media below the primary image.",
      "reason": "Preserves the techno-artisanal visual identity while removing repeated imagery and improving the hierarchy of each work record."
    },
    {
      "name": "Editorial navigation",
      "decision": "Use a persistent dark editorial sidebar with restrained Lucide line icons and a green icon-only active accent.",
      "reason": "Matches the techno-artisanal admin reference while keeping navigation states legible and consistent with the public green accent."
    },
    {
      "name": "Artisan profile portrait",
      "decision": "Keep the authorized portrait inside the existing desktop-window frame, but cap it at a compact portrait width beside the artisan narrative.",
      "reason": "Keeps the portrait present without overpowering the artisan's story and aligns profile hierarchy with the compact work detail page."
    }
